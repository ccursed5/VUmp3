# Copy this file to .env and fill in credentials from your Midtrans dashboard.
# Never put Server Key in dashboard.html or expose it to browser clients.
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false
PORT=3000
PREMIUM_PRICE_IDR=13000
PREMIUM_DAYS=30
